{
  "name": "towertrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "tsx scripts/prepare-e2e-database.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "import:lindiana:stage": "tsx scripts/stage-lindiana-import.ts",
    "import:lindiana:apply": "tsx scripts/apply-lindiana-staging.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.525.0",
    "next": "^15.5.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.11.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
