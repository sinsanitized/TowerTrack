# Production: paste the Supavisor Session pooler URL from Supabase → Connect.
# Use a dedicated Prisma database user and percent-encode special password characters.
DATABASE_URL="postgresql://prisma.[PROJECT_REF]:[PASSWORD]@[DB_REGION].pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@towertrack.local
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
INITIAL_ORGANIZATION_NAME=TowerTrack
SEED_ON_EMPTY=false
DEMO_MODE=false
TZ=America/New_York

# Browser tests must use a separate database whose name contains "test" or "e2e".
E2E_DATABASE_URL="postgresql://towertrack:towertrack@127.0.0.1:55432/towertrack_e2e?schema=public"
E2E_TEST_MODE=false
